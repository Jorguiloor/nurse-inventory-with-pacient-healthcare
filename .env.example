# Neon: DATABASE_URL es la cadena de conexión agrupada (pooler), DIRECT_URL es la directa (usada para migraciones).
# Para un Postgres local, configura ambas con el mismo valor.
#
# Supabase: el host directo db.<ref>.supabase.co es solo IPv6. Usa el pooler IPv4 en su lugar:
#   DATABASE_URL  postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#   DIRECT_URL    postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/medicheck?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/medicheck?sslmode=require"

# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""

# Requerido fuera de Vercel/Cloudflare Pages para que Auth.js acepte el encabezado Host entrante.
AUTH_TRUST_HOST="true"

# Zona horaria IANA para la clínica y cálculos de fechas (por defecto: America/Guayaquil)
APP_TIMEZONE="America/Guayaquil"

# Cuántos días hacia atrás puede registrar un movimiento un usuario NURSE (Enfermería). Los administradores no tienen límite. Por defecto 3.
NURSE_BACKDATE_DAYS="3"

# Usado únicamente por `npm run db:seed` para crear la primera cuenta de administrador en MediCheck.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@medicheck.local"
SEED_ADMIN_PASSWORD=""
